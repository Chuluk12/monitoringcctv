# Copy this file to .env and fill in real values before running docker compose.
# Never commit the real .env file.

# --- Postgres ---
POSTGRES_DB=cctv_monitoring
POSTGRES_USER=cctv
POSTGRES_PASSWORD=CHANGE_ME

# --- Backend ---
# Random long string, e.g: openssl rand -hex 32
JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET
# AES-256 key for encrypting NVR passwords at rest. Must be 64 hex chars (32 bytes).
# Generate with: openssl rand -hex 32
CRED_ENC_KEY=CHANGE_TO_A_64_CHAR_HEX_STRING
# Origin allowed to call the API (your frontend URL)
CORS_ORIGIN=http://localhost:3000
HEALTH_CHECK_INTERVAL_SECONDS=15

# --- Frontend (baked in at build time) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WEBRTC_BASE=http://localhost:8889
